{
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "kind": "database",
  "connector_id": "postgres",
  "display_name": "PostgreSQL",
  "description": "PostgreSQL database connector. Reads and writes Arrow data over the first-class ADBC libpq driver (COPY-based bulk ingestion) as the default transport, with an async SQLAlchemy (asyncpg) transport as the engine-side SQL path. Username/password authentication, libpq TLS modes (disable through verify-full), and table/view discovery via information_schema.",
  "documentation_url": "https://www.postgresql.org/docs/current/",
  "tags": [
    "database",
    "postgresql",
    "postgres",
    "sql",
    "adbc",
    "sqlalchemy"
  ],
  "version": "1.0.0",
  "default_transport": "database",
  "transports": {
    "database": {
      "transport_type": "adbc",
      "driver": "postgresql",
      "dsn": {
        "kind": "url_template",
        "template": "postgresql://{username}:{password}@{host}:{port}/{database}",
        "bindings": {
          "username": {
            "value": {
              "ref": "connection.parameters.username"
            },
            "encoding": "url_userinfo"
          },
          "password": {
            "value": {
              "ref": "secrets.password"
            },
            "encoding": "url_userinfo"
          },
          "host": {
            "value": {
              "ref": "connection.parameters.host"
            },
            "encoding": "host"
          },
          "port": {
            "value": {
              "ref": "connection.parameters.port"
            },
            "encoding": "raw"
          },
          "database": {
            "value": {
              "ref": "connection.parameters.database"
            },
            "encoding": "url_path_segment"
          }
        }
      },
      "db_kwargs": {
        "adbc.postgresql.sslmode": {
          "ref": "connection.parameters.ssl_mode"
        }
      }
    },
    "sqlalchemy": {
      "transport_type": "sqlalchemy",
      "driver": "postgresql+asyncpg",
      "dsn": {
        "kind": "url_template",
        "template": "postgresql+asyncpg://{username}:{password}@{host}:{port}/{database}",
        "bindings": {
          "username": {
            "value": {
              "ref": "connection.parameters.username"
            },
            "encoding": "url_userinfo"
          },
          "password": {
            "value": {
              "ref": "secrets.password"
            },
            "encoding": "url_userinfo"
          },
          "host": {
            "value": {
              "ref": "connection.parameters.host"
            },
            "encoding": "host"
          },
          "port": {
            "value": {
              "ref": "connection.parameters.port"
            },
            "encoding": "raw"
          },
          "database": {
            "value": {
              "ref": "connection.parameters.database"
            },
            "encoding": "url_path_segment"
          }
        }
      },
      "tls": {
        "mode": {
          "ref": "connection.parameters.ssl_mode"
        },
        "ca_certificate": {
          "ref": "secrets.ssl_ca_certificate"
        }
      }
    }
  },
  "auth": {
    "type": "db"
  },
  "connection_contract": {
    "inputs": {
      "host": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "default": "127.0.0.1",
        "ui": {
          "label": "Host",
          "widget": "text",
          "placeholder": "e.g. 127.0.0.1 or db.example.com"
        }
      },
      "port": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "integer",
        "required": true,
        "default": 5432,
        "ui": {
          "label": "Port",
          "widget": "text"
        }
      },
      "database": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Database",
          "widget": "text",
          "placeholder": "e.g. my_database"
        }
      },
      "username": {
        "source": "user",
        "phase": "auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Username",
          "widget": "text",
          "placeholder": "e.g. postgres"
        }
      },
      "password": {
        "source": "user",
        "phase": "auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true,
        "ui": {
          "label": "Password",
          "widget": "password"
        }
      },
      "ssl_mode": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "enum": [
          "disable",
          "allow",
          "prefer",
          "require",
          "verify-ca",
          "verify-full"
        ],
        "default": "prefer",
        "ui": {
          "label": "SSL Mode",
          "widget": "select",
          "options": [
            {
              "value": "disable",
              "label": "Disable"
            },
            {
              "value": "allow",
              "label": "Allow"
            },
            {
              "value": "prefer",
              "label": "Prefer (Default)"
            },
            {
              "value": "require",
              "label": "Require"
            },
            {
              "value": "verify-ca",
              "label": "Verify CA"
            },
            {
              "value": "verify-full",
              "label": "Verify Full"
            }
          ]
        }
      },
      "ssl_ca_certificate": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "secrets",
        "type": "string",
        "required": false,
        "secret": true,
        "ui": {
          "label": "SSL CA Certificate",
          "widget": "textarea"
        }
      }
    },
    "validation": {
      "rules": [
        {
          "when": {
            "field": "ssl_mode",
            "in": [
              "verify-ca",
              "verify-full"
            ]
          },
          "require": [
            "ssl_ca_certificate"
          ],
          "message": "ssl_ca_certificate is required when ssl_mode is verify-ca or verify-full"
        }
      ]
    }
  },
  "resource_discovery": {
    "strategy": "information_schema",
    "transport_ref": "database",
    "implementation": {
      "type": "builtin"
    },
    "options": {
      "exclude_schemas": [
        "information_schema",
        "pg_catalog",
        "pg_toast"
      ]
    },
    "produces": [
      "connection.endpoints",
      "connection.type_map"
    ],
    "triggers": {
      "list_resources": "on_activation",
      "describe_resource": "on_resource_selected"
    }
  }
}
