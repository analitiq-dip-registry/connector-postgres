{
  "$schema": "https://schemas.analitiq.ai/connector/latest.json",
  "kind": "database",
  "connector_id": "postgres",
  "display_name": "PostgreSQL",
  "description": "PostgreSQL database connector. Reads and writes Arrow data over the first-class ADBC libpq driver (COPY-based bulk ingestion) as the default transport, with an async SQLAlchemy (asyncpg) transport as the engine-side SQL/metadata path. Username/password authentication, libpq TLS modes (disable through verify-full), schema/table/view discovery via information_schema, and declared SQL write-path capabilities (INSERT ... ON CONFLICT upsert, real staging relations, transactional DDL, ADBC native ingest).",
  "documentation_url": "https://www.postgresql.org/docs/current/",
  "tags": [
    "database",
    "postgresql",
    "postgres",
    "sql",
    "adbc",
    "sqlalchemy"
  ],
  "version": "1.0.0",
  "default_transport": "database",
  "transports": {
    "database": {
      "transport_type": "adbc",
      "driver": "postgresql",
      "dsn": {
        "kind": "url_template",
        "template": "postgresql://{username}:{password}@{host}:{port}/{database}",
        "bindings": {
          "username": {
            "value": { "ref": "connection.parameters.username" },
            "encoding": "url_userinfo"
          },
          "password": {
            "value": { "ref": "secrets.password" },
            "encoding": "url_userinfo"
          },
          "host": {
            "value": { "ref": "connection.parameters.host" },
            "encoding": "host"
          },
          "port": {
            "value": { "ref": "connection.parameters.port" },
            "encoding": "raw"
          },
          "database": {
            "value": { "ref": "connection.parameters.database" },
            "encoding": "url_path_segment"
          }
        }
      }
    },
    "sqlalchemy": {
      "transport_type": "sqlalchemy",
      "driver": "postgresql+asyncpg",
      "dsn": {
        "kind": "url_template",
        "template": "postgresql+asyncpg://{username}:{password}@{host}:{port}/{database}",
        "bindings": {
          "username": {
            "value": { "ref": "connection.parameters.username" },
            "encoding": "url_userinfo"
          },
          "password": {
            "value": { "ref": "secrets.password" },
            "encoding": "url_userinfo"
          },
          "host": {
            "value": { "ref": "connection.parameters.host" },
            "encoding": "host"
          },
          "port": {
            "value": { "ref": "connection.parameters.port" },
            "encoding": "raw"
          },
          "database": {
            "value": { "ref": "connection.parameters.database" },
            "encoding": "url_path_segment"
          }
        }
      },
      "tls": {
        "mode": { "ref": "connection.parameters.ssl_mode" },
        "ca_certificate": { "ref": "secrets.ssl_ca_certificate" }
      }
    }
  },
  "auth": {
    "type": "db"
  },
  "connection_contract": {
    "inputs": {
      "host": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Host",
          "widget": "text",
          "placeholder": "e.g. db.example.com",
          "help_text": "Hostname or IP address of the PostgreSQL server."
        }
      },
      "port": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "integer",
        "required": true,
        "default": 5432,
        "ui": {
          "label": "Port",
          "widget": "number",
          "help_text": "TCP port the server listens on; 5432 by default."
        }
      },
      "database": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Database",
          "widget": "text",
          "placeholder": "e.g. my_database",
          "help_text": "A PostgreSQL session can only address one database; pick the one to replicate."
        }
      },
      "username": {
        "source": "user",
        "phase": "auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": true,
        "ui": {
          "label": "Username",
          "widget": "text",
          "placeholder": "e.g. postgres"
        }
      },
      "password": {
        "source": "user",
        "phase": "auth",
        "storage": "secrets",
        "type": "string",
        "required": true,
        "secret": true,
        "ui": {
          "label": "Password",
          "widget": "password"
        }
      },
      "ssl_mode": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "connection.parameters",
        "type": "string",
        "required": false,
        "enum": [
          "disable",
          "allow",
          "prefer",
          "require",
          "verify-ca",
          "verify-full"
        ],
        "default": "prefer",
        "ui": {
          "label": "SSL Mode",
          "widget": "select",
          "help_text": "libpq sslmode vocabulary. 'prefer' is PostgreSQL's documented default and falls back to plaintext if the server declines TLS; use 'require' or higher to forbid that fallback.",
          "options": [
            { "value": "disable", "label": "Disable - never use SSL" },
            { "value": "allow", "label": "Allow - plaintext first, SSL as fallback" },
            { "value": "prefer", "label": "Prefer - SSL first, plaintext as fallback (default)" },
            { "value": "require", "label": "Require - SSL only, verify CA if one is supplied" },
            { "value": "verify-ca", "label": "Verify CA - SSL only, verify the issuing CA" },
            { "value": "verify-full", "label": "Verify Full - verify CA and server hostname" }
          ]
        }
      },
      "ssl_ca_certificate": {
        "source": "user",
        "phase": "pre_auth",
        "storage": "secrets",
        "type": "string",
        "required": false,
        "secret": true,
        "ui": {
          "label": "SSL CA Certificate",
          "widget": "textarea",
          "help_text": "PEM-encoded CA bundle used to verify the server certificate. Required for verify-ca and verify-full; when supplied with 'require', libpq verifies the CA as if verify-ca had been requested."
        }
      }
    },
    "validation": {
      "rules": [
        {
          "when": {
            "field": "ssl_mode",
            "in": ["verify-ca", "verify-full"]
          },
          "require": ["ssl_ca_certificate"],
          "message": "ssl_ca_certificate is required when ssl_mode is verify-ca or verify-full"
        }
      ]
    }
  },
  "sql_capabilities": {
    "catalog": "none",
    "session_targeting": "per_statement",
    "merge_form": "insert_on_conflict",
    "bulk_load": {
      "adbc": "adbc_ingest"
    },
    "stage": {
      "scope": "real",
      "schema": "target",
      "transactional_ddl": true
    },
    "limits": {
      "max_bind_params": 65535,
      "max_identifier_len": 63
    }
  },
  "error_map": {
    "sqlstate": {
      "08000": "unreachable",
      "08001": "unreachable",
      "08003": "unreachable",
      "08004": "unreachable",
      "08006": "unreachable",
      "08007": "transient",
      "08P01": "transient",
      "22001": "write_rejected",
      "22003": "write_rejected",
      "22012": "write_rejected",
      "22P02": "write_rejected",
      "23000": "write_rejected",
      "23001": "write_rejected",
      "23502": "write_rejected",
      "23503": "write_rejected",
      "23505": "write_rejected",
      "23514": "write_rejected",
      "23P01": "write_rejected",
      "28000": "auth",
      "28P01": "auth",
      "3D000": "config",
      "3F000": "config",
      "40000": "transient",
      "40001": "transient",
      "40002": "write_rejected",
      "40003": "transient",
      "40P01": "transient",
      "42501": "auth",
      "42601": "config",
      "42703": "config",
      "42P01": "config",
      "53000": "transient",
      "53100": "transient",
      "53200": "transient",
      "53300": "rate_limited",
      "53400": "config",
      "55000": "config",
      "55006": "transient",
      "55P02": "config",
      "55P03": "transient",
      "55P04": "config",
      "57000": "transient",
      "57014": "transient",
      "57P01": "transient",
      "57P02": "transient",
      "57P03": "unreachable",
      "57P04": "config",
      "57P05": "transient",
      "58000": "transient",
      "58030": "transient",
      "58P01": "config",
      "58P02": "config",
      "58P03": "config",
      "XX000": "transient",
      "XX001": "config",
      "XX002": "config"
    }
  },
  "resource_discovery": {
    "strategy": "information_schema",
    "transport_ref": "database",
    "implementation": {
      "type": "builtin"
    },
    "options": {
      "exclude_schemas": [
        "information_schema",
        "pg_catalog",
        "pg_toast"
      ]
    },
    "produces": [
      "connection.endpoints",
      "connection.type_map"
    ],
    "triggers": {
      "list_resources": "on_activation",
      "describe_resource": "on_resource_selected"
    }
  }
}
